DEVICE=auto
OCR_ENGINE=easyocr
OCR_LANGUAGES=["en","pl"]

USE_VLM=false
VLM_LOAD_IN_8BIT=false
VLM_FLASH_ATTENTION2=false

# LLM: local | vllm | azure
LLM_BACKEND=local
USE_LOCAL_LLM=true
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

VLLM_BASE_URL=http://localhost:11434/v1
VLLM_MODEL=qwen2.5:0.5b
VLLM_API_KEY=EMPTY
VLLM_MAX_TOKENS=2048
VLLM_TEMPERATURE=0.1
VLLM_TIMEOUT=120.0

AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT=
AZURE_DEPLOYMENTS=[]

EMBEDDING_MODEL=sdadas/mmlw-retrieval-roberta-large
CHUNK_SIZE=400
CHUNK_OVERLAP=40
RETRIEVAL_TOP_K=5

REMOTE_EMBED_BASE_URL=
REMOTE_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
REMOTE_EMBED_API_KEY=EMPTY

PG_DSN=postgresql://ragdocs:ragdocs@postgres:5432/ragdocs
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ragdocs

KAFKA_BOOTSTRAP_SERVERS=["kafka:9092"]
KAFKA_TOPIC_FILE_UPLOADED=rag.file.uploaded
KAFKA_CONSUMER_GROUP=rag-pipeline
