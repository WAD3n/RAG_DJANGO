# ── Python ────────────────────────────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.so

# ── Django ────────────────────────────────────────────────────────────────────
backend/db.sqlite3
backend/*.sqlite3

# ── Node.js / Next.js ─────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.*.local

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
# .env.example  ← kept in repo as a template

# ── Project data (data is not version-controlled) ─────────────────────────────
ConvertedFiles/

# ── IDE / tools ───────────────────────────────────────────────────────────────
.vscode/
.idea/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# (compose files are version-controlled — only local overrides are ignored)
docker-compose.override.yml
docker-compose.local.yml

# ── Deploy ────────────────────────────────────────────────────────────────────
# Docker images (large binaries, not version-controlled)
deploy/images/
# local .env with secrets (the .env.example template is kept in repo)
deploy/.env
# TLS cert + basic auth (generated locally on the server)
deploy/certs/
deploy/nginx.htpasswd
