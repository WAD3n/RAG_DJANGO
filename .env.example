# ─── Django ─────────────────────────────────────────────────────────────────
# SECRET_KEY: change to a random string in every non-local environment
# Generate: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=ragdocs-local-dev-insecure-key
DEBUG=true

# ─── Accelerator ────────────────────────────────────────────────────────────
# auto | cuda | cpu
DEVICE=auto

# ─── OCR ────────────────────────────────────────────────────────────────────
# easyocr | tesseract | tesseract_cli | rapidocr
OCR_ENGINE=easyocr
OCR_LANGUAGES=["en","pl"]

# ─── VLM pipeline ───────────────────────────────────────────────────────────
# Replaces classic OCR with the Qwen/Qwen2.5-VL-3B-Instruct model
USE_VLM=false
VLM_LOAD_IN_8BIT=false
VLM_FLASH_ATTENTION2=false

# ─── LLM backend ────────────────────────────────────────────────────────────
# LLM_BACKEND: local | vllm | azure
# USE_LOCAL_LLM=true overrides LLM_BACKEND to "local" (backward-compat alias)
LLM_BACKEND=local
USE_LOCAL_LLM=false

# local — HuggingFace Transformers (works on Windows without a server)
LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# vllm — OpenAI-compatible server (vLLM, Ollama, LM Studio, etc.)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_API_KEY=EMPTY
VLLM_MAX_TOKENS=2048
VLLM_TEMPERATURE=0.1
VLLM_TIMEOUT=120.0

# azure — Azure OpenAI
# AZURE_DEPLOYMENTS is the list shown in the UI dropdown
AZURE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_API_KEY=
AZURE_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT=gpt-4o
AZURE_DEPLOYMENTS=["gpt-4o"]

# ─── Local embeddings ─────────────────────────────────────────────────────────
# Used when REMOTE_EMBED_BASE_URL is empty
# sdadas/mmlw-retrieval-roberta-large — asymmetric PL, 1024 dim
EMBEDDING_MODEL=sdadas/mmlw-retrieval-roberta-large
CHUNK_SIZE=400
CHUNK_OVERLAP=40
RETRIEVAL_TOP_K=5

# ─── Remote embeddings (OpenAI-compatible) ───────────────────────────────────
# When REMOTE_EMBED_BASE_URL is set, it replaces local embeddings
# Example: nomic-ai/nomic-embed-text-v1.5 via vLLM — 768 dim
# NOTE: changing the model requires re-indexing all documents
REMOTE_EMBED_BASE_URL=
REMOTE_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
REMOTE_EMBED_API_KEY=EMPTY
REMOTE_EMBED_DIM=768

# ─── PostgreSQL / pgvector ───────────────────────────────────────────────────
# In Docker this is automatically overridden by backend/docker-compose.yml
PG_DSN=postgresql://ragdocs:ragdocs@localhost:5432/ragdocs

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ragdocs

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=["localhost:9094"]
KAFKA_TOPIC_FILE_UPLOADED=rag.file.uploaded
KAFKA_CONSUMER_GROUP=rag-pipeline
