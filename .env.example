# ─── Django ─────────────────────────────────────────────────────────────────
# SECRET_KEY: zmień na losowy string w każdym środowisku nielokalnym
# Generuj: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=ragdocs-local-dev-insecure-key
DEBUG=true

# ─── Akcelerator ────────────────────────────────────────────────────────────
# auto | cuda | cpu
DEVICE=auto

# ─── OCR ────────────────────────────────────────────────────────────────────
# easyocr | tesseract | tesseract_cli | rapidocr
OCR_ENGINE=easyocr
OCR_LANGUAGES=["en","pl"]

# ─── VLM pipeline ───────────────────────────────────────────────────────────
# Zastępuje klasyczny OCR modelem Qwen/Qwen2.5-VL-3B-Instruct
USE_VLM=false
VLM_LOAD_IN_8BIT=false
VLM_FLASH_ATTENTION2=false

# ─── LLM backend ────────────────────────────────────────────────────────────
# LLM_BACKEND: local | vllm | azure
# USE_LOCAL_LLM=true nadpisuje LLM_BACKEND na "local" (alias wstecznej kompatybilności)
LLM_BACKEND=local
USE_LOCAL_LLM=false

# local — HuggingFace Transformers (działa na Windows bez serwera)
LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# vllm — OpenAI-compatible server (vLLM, Ollama, LM Studio itp.)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_API_KEY=EMPTY
VLLM_MAX_TOKENS=2048
VLLM_TEMPERATURE=0.1
VLLM_TIMEOUT=120.0

# azure — Azure OpenAI
# AZURE_DEPLOYMENTS to lista widoczna w dropdownie UI
AZURE_ENDPOINT=https://<zasob>.cognitiveservices.azure.com/
AZURE_API_KEY=
AZURE_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT=gpt-4o
AZURE_DEPLOYMENTS=["gpt-4o"]

# ─── Embeddings lokalne ──────────────────────────────────────────────────────
# Używane gdy REMOTE_EMBED_BASE_URL jest puste
# sdadas/mmlw-retrieval-roberta-large — asymetryczne PL, 1024 dim
EMBEDDING_MODEL=sdadas/mmlw-retrieval-roberta-large
CHUNK_SIZE=400
CHUNK_OVERLAP=40
RETRIEVAL_TOP_K=5

# ─── Embeddings zdalne (OpenAI-compatible) ───────────────────────────────────
# Gdy REMOTE_EMBED_BASE_URL jest ustawiony, zastępuje lokalne embeddingi
# Przykład: nomic-ai/nomic-embed-text-v1.5 przez vLLM — 768 dim
# UWAGA: zmiana modelu wymaga ponownego indeksowania dokumentów
REMOTE_EMBED_BASE_URL=
REMOTE_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
REMOTE_EMBED_API_KEY=EMPTY
REMOTE_EMBED_DIM=768

# ─── PostgreSQL / pgvector ───────────────────────────────────────────────────
# W Dockerze nadpisywane automatycznie przez backend/docker-compose.yml
PG_DSN=postgresql://ragdocs:ragdocs@localhost:5432/ragdocs

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ragdocs

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=["localhost:9094"]
KAFKA_TOPIC_FILE_UPLOADED=rag.file.uploaded
KAFKA_CONSUMER_GROUP=rag-pipeline
