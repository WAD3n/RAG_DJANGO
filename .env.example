# Accelerator: auto | cuda | cpu
DEVICE=auto

# OCR engine: easyocr | tesseract | tesseract_cli | rapidocr
OCR_ENGINE=easyocr
# Comma-separated ISO 639-1 language codes
OCR_LANGUAGES=["en","pl"]

# VLM pipeline — uses Qwen/Qwen2.5-VL-3B-Instruct instead of classic OCR
USE_VLM=false
# Set true to load model in 8-bit (requires bitsandbytes, halves VRAM usage ~6→3 GB)
VLM_LOAD_IN_8BIT=false
# Set true for Flash Attention 2 speedup (requires flash-attn, Ampere GPU or newer)
VLM_FLASH_ATTENTION2=false

# LLM backend
# USE_LOCAL_LLM=true  → local transformers (no server needed, works on Windows)
# USE_LOCAL_LLM=false → remote OpenAI-compatible server (vLLM on Linux/WSL2, or Ollama)
USE_LOCAL_LLM=false
LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Remote server (vllm serve <model>  or  ollama serve, then VLLM_BASE_URL=http://localhost:11434/v1)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_API_KEY=EMPTY
VLLM_MAX_TOKENS=2048
VLLM_TEMPERATURE=0.1
VLLM_TIMEOUT=120.0

# Embeddings
EMBEDDING_MODEL=sdadas/mmlw-retrieval-roberta-large
CHUNK_SIZE=400
CHUNK_OVERLAP=40
RETRIEVAL_TOP_K=5

# PostgreSQL / pgvector  (docker compose up -d)
PG_DSN=postgresql://ragdocs:ragdocs@localhost:5432/ragdocs

# Output directory for converted documents
OUTPUT_DIR=ConvertedFiles
